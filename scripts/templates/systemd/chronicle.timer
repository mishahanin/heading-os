[Unit]
Description=Daily 31C Conversation Chronicle build (03:00, configured timezone)

[Timer]
# Daily incremental chronicle build at 03:00 -- deliberately BEFORE the 03:30
# memory-index refresh, so the day's new business chronicle entries are embedded
# into the recall index the same night. The zone is named rather than inherited
# from the host: this unit's script DOES do date math (it derives its catch-up
# window from today's date), so the previous "no date math, the hour is
# cosmetic" rationale was wrong, and 03:00 sits inside the window where a host
# on another zone files the run under the previous day. Persistent=true runs a
# missed fire on next boot (covers "the machine was off overnight") without a
# separate OnBootSec trigger and without racing a manual build at install time.
OnCalendar=*-*-* 03:00:00 {{TZ}}
Persistent=true

[Install]
WantedBy=timers.target
