[Unit]
Description=HEADING OS nightly router-accuracy trend (skill-trigger-test -> data-overlay trend)
After=network.target

[Service]
Type=oneshot
WorkingDirectory={{WORKSPACE}}
ExecStart={{PYTHON}} {{WORKSPACE}}/scripts/router-accuracy-nightly.py
# TZ pins the artifact's date (YYYY-MM-DD) to the configured timezone regardless of
# the host. The installer substitutes {{TZ}} from HEADING_OS_TZ (default UTC).
# journald avoids a log path on a /mnt/c 9P mount. Unlike ops-radar-notify.py the
# runner exits 1 on a real harness failure, so a non-zero exit correctly surfaces as
# `failed` (no SuccessExitStatus override). The runner skips (exit 0) under
# SENSITIVE_MODE; the drop-flag is surfaced separately by the ops-radar router_accuracy
# signal on the ops-radar timer, not here.
Environment=TZ={{TZ}}
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
