#!/usr/bin/env bash
# heading-os-data-test-gate
#
# Versioned pre-push gate for a DATA overlay repository. Installed into
# <data-repo>/.git/hooks/pre-push by `python scripts/install-git-hooks.py`.
#
# Two things this hook has to get right that the engine's does not:
#
#   1. It REPLACES the stock git-lfs pre-push hook, and a data overlay really does
#      track LFS objects. So it delegates to `git lfs pre-push` at the end. Drop
#      that line and pushes stop uploading LFS content.
#   2. An executive's data overlay carries no tests/ directory. Absence is normal
#      and must pass, not fail closed. Only the CEO overlay carries admin tests.
#
# Never bypass with --no-verify.
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

if [ -d "$ROOT/tests" ]; then
    # The data overlay has no interpreter of its own, so it borrows the engine's.
    # That path is STAMPED IN at install time by scripts/install-git-hooks.py,
    # which already resolved it with get_workspace_root(). It was guessed here
    # until 2026-08-21, as "the sibling directory named .heading-os" - a name this
    # workspace nowhere promises. A public clone is `heading-os`, and every other
    # installer under scripts/ self-locates rather than assume a layout.
    #
    # A wrong guess did not fail loudly, which is the part that mattered: it fell
    # through to a bare `python3`, and a machine with pytest on PATH (9.0.3 here)
    # then ran the overlay's tests green under an interpreter carrying none of the
    # pinned dependencies. Hence the warning below rather than a silent fallback.
    ENGINE="@@ENGINE_ROOT@@"
    if [ -x "$ENGINE/.venv/bin/python" ]; then
        PY="$ENGINE/.venv/bin/python"
    else
        PY="python3"
        echo "data overlay test gate: no engine venv at '$ENGINE' - falling back to" \
             "$(command -v python3 || echo python3), which is NOT the pinned" \
             "toolchain. Re-arm with: python scripts/install-git-hooks.py" >&2
    fi
    echo "data overlay test gate: $ROOT/tests"
    # PYTHONDONTWRITEBYTECODE and no:cacheprovider are load-bearing, not tidiness.
    #
    # This gate runs pytest INSIDE the operator's data overlay, and the overlay
    # write guard refuses any write there from an untracked caller. pytest is
    # untracked (it lives in the engine's .venv), and it writes two things into
    # the tree it collects from: assertion-rewritten `.pyc` files under
    # `__pycache__/`, and its own `.pytest_cache/`.
    #
    # So the gate passed only while the bytecode cache was warm AND current.
    # Measured 2026-09-01: editing two files under `tests/admin/` made the very
    # next push fail at COLLECTION with OverlayWriteRefused, on a repository whose
    # tests all pass. The gate was not failing on the tests; it could not reach
    # them. A gate that breaks whenever the thing it guards is edited is a gate
    # that trains its operator to bypass it.
    #
    # Refusing the write is correct and stays. The gate stops asking for it.
    if ! PYTHONDONTWRITEBYTECODE=1 "$PY" -m pytest "$ROOT/tests" -q -p no:cacheprovider; then
        echo "data overlay tests failed - push blocked" >&2
        exit 1
    fi
fi

# Hand off to git-lfs, which owned this hook slot before the gate did. Git calls a
# pre-push hook with <remote> <url>; `git lfs pre-push` needs them, so a call with
# no arguments is not a real push and there is nothing to hand over.
if [ "$#" -gt 0 ] && command -v git-lfs >/dev/null 2>&1; then
    exec git lfs pre-push "$@"
fi
exit 0
