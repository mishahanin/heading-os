#!/usr/bin/env bash
# Versioned pre-push gate. Installed into .git/hooks/pre-push by
# `python scripts/install-git-hooks.py`. Runs the regression test gate;
# a non-zero result blocks the push. Never bypass with --no-verify.
#
# This hook OCCUPIES the slot git-lfs installs into, and the engine really does
# track LFS objects - see the `filter=lfs` block at the top of .gitattributes. So
# it hands off to `git lfs pre-push` at the end, for exactly the reason
# .githooks/pre-push-data spells out: drop that line and a newly added .png,
# .pdf, .pptx or .docx pushes as a POINTER with no object behind it, and the next
# fresh clone's `git lfs pull` fails on it. The gap was silent between 2026-06-29
# and 2026-08-21 only because every one of the engine's nine LFS files was added
# on the day the hook first replaced the stock one, so none needed uploading
# afterwards. Absence of a symptom was not coverage.
#
# STDIN IS READ ONCE, HERE, AND REPLAYED TO BOTH CONSUMERS. Git writes one line
# per ref, `<local ref> <local sha> <remote ref> <remote sha>`, and that is the
# authoritative statement of what this push adds. Since 2026-09-04 the test gate
# needs it too, to run the tests this push can reach instead of all 24805 of
# them (MEASURED 2026-09-04, one clean full run over the merged tree at ca9457d:
# 24805 passed, 2 skipped, 979 s).
#
# A pipe is consumed by whoever reads it first, so the note above (verified
# 2026-08-21, that the ref lines survive the test run intact) stopped being true
# the moment anything upstream of git-lfs read them. It held only because nothing
# did, which is a property of what was absent rather than a guarantee. `$(cat)`
# takes the lines once and `printf` feeds each consumer its own copy.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"

# `$(cat)` strips every trailing newline; `printf '%s\n'` puts exactly one back,
# which is the shape git wrote. Empty stays empty rather than becoming a blank
# line, so neither consumer is handed a ref line that is not there.
REFS="$(cat)"
replay_refs() {
    if [ -n "$REFS" ]; then
        printf '%s\n' "$REFS"
    fi
}
if [ -x "$ROOT/.venv/bin/python" ]; then
    PY="$ROOT/.venv/bin/python"
else
    # Loud, not silent. The sibling hook `.githooks/pre-push-data` carries the
    # measurement: a bare `python3` with pytest on PATH (9.0.3 here) runs the
    # suite GREEN under an interpreter holding none of the pinned dependencies,
    # so the last gate before the push wall passes on a toolchain nobody chose.
    # That hook has warned since 2026-08-21; this one, guarding the repo that
    # actually owns the pinned toolchain, still fell through in silence until
    # 2026-08-23.
    PY="python3"
    echo "engine test gate: no venv at '$ROOT/.venv' - falling back to" \
         "$(command -v python3 || echo python3), which is NOT the pinned" \
         "toolchain. Re-arm with: uv sync --all-extras --group dev" >&2
fi
replay_refs | "$PY" "$ROOT/scripts/run-tests.py" --pre-push

# Hand off to git-lfs, which owned this hook slot before the gate did. Git calls a
# pre-push hook with <remote> <url>; `git lfs pre-push` needs them, so a call with
# no arguments is not a real push and there is nothing to hand over. git-lfs reads
# the SAME ref lines the gate just read, from the replay above, and decides which
# objects to upload from them. Drop the replay and a newly added .png, .pdf,
# .pptx or .docx pushes as a POINTER with no object behind it.
if [ "$#" -gt 0 ] && command -v git-lfs >/dev/null 2>&1; then
    replay_refs | git lfs pre-push "$@"
    exit $?
fi
exit 0
