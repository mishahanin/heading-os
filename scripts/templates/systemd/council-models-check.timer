[Unit]
Description=Daily HEADING OS council model freshness check (08:30, configured timezone)

[Timer]
# 08:30 daily in the configured timezone. The installer substitutes {{TZ}} from
# HEADING_OS_TZ (default UTC); the trailing timezone pins the fire even when the
# host's local timezone differs (systemd >= 252). Persistent=true catches a fire
# missed because the host was off, running it on next boot.
OnCalendar=*-*-* 08:30:00 {{TZ}}
Persistent=true

[Install]
WantedBy=timers.target
